@model CinemaBooking.Models.Booking

@{
    ViewData["Title"] = "Create Booking";
}

<h1>Create Booking</h1>

<hr />

<form asp-action="Create">

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <div class="form-group mb-3">

        <label asp-for="PhoneNumber"
               class="control-label">

            Phone Number

        </label>

        <input asp-for="PhoneNumber"
               class="form-control" />

        <span asp-validation-for="PhoneNumber"
              class="text-danger">
        </span>

    </div>

    <div class="form-group mb-3">

        <label class="control-label">
            Schedule
        </label>

        <select name="scheduleId"
                class="form-control">

            <option value="">
                -- Select Schedule --
            </option>

            @foreach (var schedule in ViewBag.Schedules)
            {
                <option value="@schedule.ScheduleId">

                    @schedule.Movie.MovieName
                    -
                    @schedule.Cinema.CinemaName
                    -
                    @schedule.ShowDate.ToString("dd/MM/yyyy")
                    -
                    @schedule.ShowPeriod.ToString(@"hh\:mm")

                </option>
            }

        </select>

    </div>

    <button type="submit"
            class="btn btn-primary">

        Continue

    </button>

</form>

<div class="mt-3">

    <a asp-action="Index">
        Back to List
    </a>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}