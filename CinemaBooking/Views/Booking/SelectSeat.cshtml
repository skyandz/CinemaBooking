                        <input type="checkbox"
                               name="selectedSeats"
                               value="@seatNo"
                        @(isBooked ? "disabled" : "") />

                        @seatNo

                    </label>
                }

            </div>
        }

    </div>

    <button type="submit"
            class="btn btn-primary">

        Confirm Booking

    </button>

</form> *@