@model IEnumerable<CinemaBooking.Models.Cinema>

@{
    ViewData["Title"] = "Index";
}

<h1>Cinemas</h1>

<p>
    <a asp-action="Create">+Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Cinema Name
            </th>
            <th>
                Row
            </th>
            <th>
                Column
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.CinemaName)
            </td>
            <td>
                @Html.DisplayFor(model => item.RowCount)
            </td>
            <td>
                @Html.DisplayFor(model => item.ColumnCount)
            </td>

            <td>
                    <a asp-action="Edit"
                       asp-route-cinemaid="@item.CinemaId">
                        Edit
                    </a>
                    |
                    <a asp-action="Details"
                       asp-route-cinemaid="@item.CinemaId">
                        Details
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-cinemaid="@item.CinemaId">
                        Delete
                    </a>
            </td>
        </tr>
}
    </tbody>
</table>
