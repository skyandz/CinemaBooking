@model CinemaBooking.Models.Movie

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Movie</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MovieName)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MovieName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.StartDate)
        </dt>

        <dd class="col-sm-10">
            @Model.StartDate.ToString("dd/MM/yyyy")
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.StopDate)
        </dt>

        <dd class="col-sm-10">
            @Model.StopDate.ToString("dd/MM/yyyy")
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit"
       asp-route-movieid="@Model?.MovieId">
        Edit
    </a>
    |
    <a asp-action="Index">
        Back to List
    </a>
</div>