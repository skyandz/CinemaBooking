@model CinemaBooking.Models.Schedule

@{
    ViewData["Title"] = "Delete Schedule";
}

<h1>Delete Schedule</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>Schedule</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            Movie
        </dt>
        <dd class="col-sm-10">
            @Model.Movie.MovieName
        </dd>

        <dt class="col-sm-2">
            Cinema
        </dt>
        <dd class="col-sm-10">
            @Model.Cinema.CinemaName
        </dd>

        <dt class="col-sm-2">
            Show Date
        </dt>
        <dd class="col-sm-10">
            @Model.ShowDate.ToString("dd/MM/yyyy")
        </dd>

        <dt class="col-sm-2">
            Show Time
        </dt>
        <dd class="col-sm-10">
            @Model.ShowTime.ToString(@"hh\:mm")
        </dd>

    </dl>

    <form asp-action="Delete">

        <input type="hidden"
               asp-for="ScheduleId" />

        <input type="submit"
               value="Delete"
               class="btn btn-danger" />

        |

        <a asp-action="Index">
            Back to List
        </a>

    </form>
</div>