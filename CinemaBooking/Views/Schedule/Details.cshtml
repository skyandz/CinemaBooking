@model CinemaBooking.Models.Schedule

@{
    ViewData["Title"] = "Schedule Details";
}

<h1>Schedule Details</h1>

<div>
    <h4>Schedule</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            Movie
        </dt>
        <dd class="col-sm-10">
            @Model.Movie.MovieName
        </dd>

        <dt class="col-sm-2">
            Cinema
        </dt>
        <dd class="col-sm-10">
            @Model.Cinema.CinemaName
        </dd>

        <dt class="col-sm-2">
            Show Date
        </dt>
        <dd class="col-sm-10">
            @Model.ShowDate.ToString("dd/MM/yyyy")
        </dd>

        <dt class="col-sm-2">
            Show Time
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ShowPeriod)
        </dd>

    </dl>
</div>

<div>
    <a asp-action="Edit"
       asp-route-scheduleid="@Model.ScheduleId">
        Edit
    </a>
    |
    <a asp-action="Index">
        Back to List
    </a>
</div>