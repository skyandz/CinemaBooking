@model CinemaBooking.Models.Schedule

@{
    ViewData["Title"] = "Edit Schedule";
}

<h1>Edit Schedule</h1>

<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <input type="hidden"
                   asp-for="ScheduleId" />

            <div class="form-group mb-3">
                <label asp-for="MovieId"
                       class="control-label">
                    Movie
                </label>

                <select asp-for="MovieId"
                        class="form-control"
                        asp-items="ViewBag.MovieId">

                    <option value="">
                        -- Select Movie --
                    </option>

                </select>

                <span asp-validation-for="MovieId"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CinemaId"
                       class="control-label">
                    Cinema
                </label>

                <select asp-for="CinemaId"
                        class="form-control"
                        asp-items="ViewBag.CinemaId">

                    <option value="">
                        -- Select Cinema --
                    </option>

                </select>

                <span asp-validation-for="CinemaId"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ShowDate"
                       class="control-label">
                    Show Date
                </label>

                <input asp-for="ShowDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="ShowDate"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ShowTime"
                       class="control-label">
                    Show Time
                </label>

                <input asp-for="ShowTime"
                       type="time"
                       class="form-control" />

                <span asp-validation-for="ShowTime"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Save"
                       class="btn btn-primary" />
            </div>

        </form>

    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">
        Back to List
    </a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}